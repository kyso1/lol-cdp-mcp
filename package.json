{
  "name": "lol-cdp-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives the League of Legends client over the Chrome DevTools Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyso1/lol-cdp-mcp.git"
  },
  "keywords": [
    "mcp",
    "league-of-legends",
    "lcu",
    "cdp",
    "pengu-loader"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lol-cdp-mcp": "dist/server.js",
    "rlc-mcp": "dist/rlc-server.js",
    "lol-cdp-crawl": "dist/crawl.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.ts",
    "start:rlc": "node src/rlc-server.ts",
    "crawl": "node src/crawl.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
