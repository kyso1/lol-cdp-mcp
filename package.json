{
  "name": "lol-cdp-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that drives the League of Legends client over the Chrome DevTools Protocol",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "start:rlc": "node src/rlc-server.ts",
    "crawl": "node src/crawl.ts",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
